root = true

# Repository style, and the source for the managed ~/.editorconfig target:
# dot_editorconfig.tmpl includes this file, so the same rules cover this repo
# and machine-wide defaults. EditorConfig stops walking up at the first file
# with `root = true`, so a project that ships its own .editorconfig still wins
# completely.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,toml,yml,yaml,md}]
indent_size = 2

[*.{js,jsx,ts,tsx,html,css,scss}]
indent_size = 2

[*.lua]
indent_size = 2

[*.kdl]
indent_size = 4

[*.sh]
indent_size = 4
switch_case_indent = false

[*.sh.tmpl]
indent_size = 4
switch_case_indent = false

[*.ps1]
indent_size = 4

[*.ps1.tmpl]
indent_size = 4

[*.fish]
indent_size = 4

[*.fish.tmpl]
indent_size = 4

[*.{c,h,cc,cpp,hpp,cs,java,kt,kts,scala,rs,php,swift}]
indent_size = 4

[*.{py,pyi,ipynb}]
indent_size = 4
max_line_length = 100

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{md,markdown}]
# Trailing spaces are meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false
