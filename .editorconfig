root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,toml,yml,yaml,md}]
indent_size = 2

[*.lua]
indent_size = 2

[*.kdl]
indent_size = 4

[*.sh]
indent_size = 4
switch_case_indent = false

[*.sh.tmpl]
indent_size = 4
switch_case_indent = false

[*.ps1]
indent_size = 4

[*.ps1.tmpl]
indent_size = 4

[*.fish]
indent_size = 4

[*.fish.tmpl]
indent_size = 4
