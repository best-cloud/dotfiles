{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Install packages on Ubuntu Server / WSL2 with apt.
#
# This file is a `run_onchange_` script: chezmoi re-runs it only when the
# rendered contents change, so adding a package below is all that is needed.
set -eu

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        SUDO=sudo
        sudo -v
    else
        echo "error: root or sudo is required to install packages" >&2
        exit 1
    fi
fi

# Upstream installers place binaries here. OpenCode uses ~/.opencode/bin, and
# fnm installs its own binary next to the Node.js versions it manages. Include
# all of them so re-running this script sees those installs instead of
# downloading them again.
PATH="$HOME/.local/share/fnm:$HOME/.opencode/bin:$HOME/.local/bin:$PATH"
export PATH
mkdir -p "$HOME/.local/bin"

has() { command -v "$1" >/dev/null 2>&1; }

# The managed catppuccin-powerline preset uses the jj_bookmark module, which
# was added in Starship 1.27.0. Ubuntu 26.04 still packages 1.22.1, so the
# script upgrades to the upstream release when the packaged version is older.
STARSHIP_MIN_VERSION=1.27.0

# Tools packaged by every supported Ubuntu release. Optional tools are checked
# with apt-cache below and installed by their upstream installer if missing.
PACKAGES="
ca-certificates
curl
wget
git
build-essential
unzip
zip
fish
ripgrep
fd-find
bat
fzf
zoxide
eza
jq
tree
htop
btop
tmux
neovim
emacs
direnv
gh
starship
lazygit
zellij
uv
ruff
opencode
fnm
prettier
shfmt
"

echo "==> apt-get update"
$SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -y

available=""
unavailable=""
for pkg in $PACKAGES; do
    if dpkg -s "$pkg" >/dev/null 2>&1; then
        continue
    fi
    # `apt-cache show` also succeeds for a name that is only referenced by
    # another package's dependencies (on Ubuntu 26.04, `ruff` is a dependency
    # of helix) even though there is nothing to install. Require a candidate.
    if apt-cache policy "$pkg" 2>/dev/null | grep -q 'Candidate: [^(]'; then
        available="$available $pkg"
    else
        unavailable="$unavailable $pkg"
    fi
done

if [ -n "$available" ]; then
    echo "==> apt-get install:$available"
    # shellcheck disable=SC2086  # word splitting of the package list is intended
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $available
fi

# Fall back to the upstream installer only for tools that this Ubuntu release
# does not package. Downloads are best-effort so a transient network error does
# not block the rest of the dotfiles from being applied.
for pkg in $unavailable; do
    case "$pkg" in
    starship)
        has starship && continue
        echo "==> installing starship (not packaged by this Ubuntu release)"
        tmpfile=$(mktemp)
        if curl -fsSL https://starship.rs/install.sh -o "$tmpfile"; then
            sh "$tmpfile" -y -b "$HOME/.local/bin" ||
                echo "warning: starship installation failed" >&2
        else
            echo "warning: starship download failed" >&2
        fi
        rm -f "$tmpfile"
        ;;
    zellij)
        has zellij && continue
        case "$(uname -m)" in
        x86_64 | amd64) zellij_arch=x86_64 ;;
        aarch64 | arm64) zellij_arch=aarch64 ;;
        *)
            echo "warning: no zellij build for $(uname -m)" >&2
            continue
            ;;
        esac
        echo "==> installing zellij (not packaged by this Ubuntu release)"
        tmpdir=$(mktemp -d)
        if curl -fsSL "https://github.com/zellij-org/zellij/releases/latest/download/zellij-${zellij_arch}-unknown-linux-musl.tar.gz" -o "$tmpdir/zellij.tar.gz"; then
            tar -xzf "$tmpdir/zellij.tar.gz" -C "$tmpdir"
            mkdir -p "$HOME/.local/bin"
            install -m 755 "$tmpdir/zellij" "$HOME/.local/bin/zellij"
        else
            echo "warning: zellij download failed" >&2
        fi
        rm -rf "$tmpdir"
        ;;
    uv)
        has uv && continue
        echo "==> installing uv (not packaged by this Ubuntu release)"
        tmpfile=$(mktemp)
        if curl -LsSf https://astral.sh/uv/install.sh -o "$tmpfile"; then
            sh "$tmpfile" ||
                echo "warning: uv installation failed" >&2
        else
            echo "warning: uv download failed" >&2
        fi
        rm -f "$tmpfile"
        ;;
    ruff)
        has ruff && continue
        if has uv; then
            echo "==> installing ruff (not packaged by this Ubuntu release)"
            uv tool install ruff ||
                echo "warning: ruff installation failed" >&2
        else
            echo "warning: ruff needs uv or a manual install" >&2
        fi
        ;;
    opencode)
        has opencode && continue
        echo "==> installing opencode (not packaged by apt)"
        tmpfile=$(mktemp)
        if curl -fsSL https://opencode.ai/v2/install -o "$tmpfile"; then
            # --no-modify-path: fish/PowerShell configs already add ~/.opencode/bin.
            bash "$tmpfile" --no-modify-path ||
                echo "warning: opencode installation failed" >&2
        else
            echo "warning: opencode download failed" >&2
        fi
        rm -f "$tmpfile"
        ;;
    fnm)
        # Node.js is managed by fnm on Linux and macOS, never by apt or
        # Homebrew: distro packages lag behind, and `fnm install --lts` plus
        # `fnm use`/`.node-version` is how versions are switched per project.
        if ! has fnm; then
            echo "==> installing fnm (not packaged by this Ubuntu release)"
            tmpfile=$(mktemp)
            if curl -fsSL https://fnm.vercel.app/install -o "$tmpfile"; then
                # --skip-shell: fish and the Spacemacs config wire fnm up, and
                # the installer would otherwise edit the login shell's rc file.
                bash "$tmpfile" --skip-shell --install-dir "$HOME/.local/share/fnm" ||
                    echo "warning: fnm installation failed" >&2
            else
                echo "warning: fnm download failed" >&2
            fi
            rm -f "$tmpfile"
            hash -r 2>/dev/null || true
        fi
        if has fnm; then
            echo "==> installing Node.js LTS with fnm (not with apt)"
            fnm install --lts ||
                echo "warning: fnm install --lts failed" >&2
            fnm default lts-latest ||
                echo "warning: fnm default failed" >&2
            # Put the default Node.js (and its npm) on PATH for the prettier
            # step below and for anything else later in this script. fnm infers
            # the shell from the parent process, which is fish when chezmoi is
            # launched from it, so force POSIX sh syntax here.
            eval "$(fnm env --shell bash)"
            hash -r 2>/dev/null || true
        fi
        ;;
    prettier)
        has prettier && continue
        if has npm; then
            echo "==> installing prettier (npm, user prefix)"
            npm install -g --prefix "$HOME/.local" prettier ||
                echo "warning: prettier installation failed" >&2
        else
            echo "warning: prettier needs npm from fnm; skipping prettier" >&2
        fi
        ;;
    *)
        echo "warning: $pkg is not available from apt; install it manually" >&2
        ;;
    esac
done

# Ubuntu 26.04 packages Starship 1.22.1, which predates jj_bookmark and prints
# an "Unknown key" warning on every prompt. Upgrade in place; ~/.local/bin is
# first in PATH, so the newer binary shadows /usr/bin/starship.
if has starship; then
    starship_version=$(starship --version 2>/dev/null | awk 'NR == 1 {print $2}')
    if [ "$(printf '%s\n%s\n' "$STARSHIP_MIN_VERSION" "${starship_version:-0}" |
        sort -V | head -n 1)" != "$STARSHIP_MIN_VERSION" ]; then
        echo "==> upgrading starship to >= $STARSHIP_MIN_VERSION (found ${starship_version:-unknown})"
        tmpfile=$(mktemp)
        if curl -fsSL https://starship.rs/install.sh -o "$tmpfile"; then
            sh "$tmpfile" -y -b "$HOME/.local/bin" ||
                echo "warning: starship upgrade failed" >&2
        else
            echo "warning: starship download failed" >&2
        fi
        rm -f "$tmpfile"
        hash -r 2>/dev/null || true
    fi
fi

echo "==> Linux packages complete"
{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Install packages on macOS with Homebrew.
set -eu

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v brew >/dev/null 2>&1; then
    echo "==> installing Homebrew"
    # Interactive on purpose: on a fresh Mac this lets the Homebrew installer
    # offer to install the Xcode Command Line Tools as well.
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x /usr/local/bin/brew ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "warning: Homebrew is unavailable; skipping package installation" >&2
    exit 0
fi

BREW_PACKAGES="
git
fish
starship
ripgrep
fd
bat
eza
fzf
zoxide
jq
tree
htop
btop
tmux
zellij
neovim
emacs
direnv
gh
lazygit
uv
ruff
fnm
shfmt
diffutils
wget
"

missing=""
for pkg in $BREW_PACKAGES; do
    if ! brew list --formula "$pkg" >/dev/null 2>&1; then
        missing="$missing $pkg"
    fi
done

if [ -n "$missing" ]; then
    echo "==> brew install:$missing"
    # shellcheck disable=SC2086  # word splitting of the package list is intended
    brew install $missing
fi

# OpenCode's Homebrew formula lives in the upstream tap instead of homebrew-core.
if ! command -v opencode >/dev/null 2>&1; then
    echo "==> brew install anomalyco/tap/opencode-v2"
    brew install anomalyco/tap/opencode-v2 ||
        echo "warning: OpenCode installation failed" >&2
fi

# The Starship prompt uses Nerd Font glyphs. The font must be installed on the
# machine that renders the terminal, so it is a macOS cask (Linux/WSL render in
# the client terminal instead).
BREW_CASKS="
font-jetbrains-mono-nerd-font
ghostty
"

missing_casks=""
for cask in $BREW_CASKS; do
    if ! brew list --cask "$cask" >/dev/null 2>&1; then
        missing_casks="$missing_casks $cask"
    fi
done

if [ -n "$missing_casks" ]; then
    echo "==> brew install --cask:$missing_casks"
    # shellcheck disable=SC2086  # word splitting of the cask list is intended
    brew install --cask $missing_casks
fi

# Node.js is managed by fnm on Linux and macOS, never by apt or Homebrew: the
# distro formulae lag behind, and `fnm install --lts` plus `fnm use` or a
# project `.node-version` is how versions are switched. The `node` and
# `prettier` formulae are deliberately absent from BREW_PACKAGES because the
# `prettier` formula would pull Node.js back in as a dependency.
if command -v fnm >/dev/null 2>&1; then
    echo "==> installing Node.js LTS with fnm (not with Homebrew)"
    fnm install --lts ||
        echo "warning: fnm install --lts failed" >&2
    fnm default lts-latest ||
        echo "warning: fnm default failed" >&2
    # fnm infers the shell from the parent process; force sh syntax so the
    # macOS branch also works when chezmoi is started from fish or zsh.
    eval "$(fnm env --shell bash)"
    hash -r 2>/dev/null || true

    if command -v npm >/dev/null 2>&1; then
        if ! command -v prettier >/dev/null 2>&1; then
            echo "==> installing prettier (npm, user prefix)"
            mkdir -p "$HOME/.local/bin"
            npm install -g --prefix "$HOME/.local" prettier ||
                echo "warning: prettier installation failed" >&2
        fi
    else
        echo "warning: npm was not found; prettier was not installed" >&2
    fi
else
    echo "warning: fnm is unavailable; Node.js and prettier were not installed" >&2
fi

echo "==> macOS packages complete"
{{ end -}}
