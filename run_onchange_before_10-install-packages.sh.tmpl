{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Install packages on Ubuntu Server / WSL2 with apt.
#
# This file is a `run_onchange_` script: chezmoi re-runs it only when the
# rendered contents change, so adding a package below is all that is needed.
set -eu

{{ include "scripts/lib/shell.sh" }}
{{ include "scripts/lib/installers.sh" }}
if ! can_root; then
    echo "error: root or sudo is required to install packages" >&2
    exit 1
fi
if [ "$(id -u)" -ne 0 ]; then
    sudo -v
fi

# Upstream installers place binaries here. OpenCode uses ~/.opencode/bin, and
# fnm installs its own binary next to the Node.js versions it manages. Include
# all of them so re-running this script sees those installs instead of
# downloading them again.
PATH="$HOME/.local/share/fnm:$HOME/.opencode/bin:$HOME/.local/bin:$PATH"
export PATH
mkdir -p "$HOME/.local/bin"

has() { native_cmd "$1"; }

# The managed catppuccin-powerline preset uses the jj_bookmark module, which
# was added in Starship 1.27.0. Ubuntu 26.04 still packages 1.22.1, so the
# script upgrades to the upstream release when the packaged version is older.
STARSHIP_MIN_VERSION=1.27.0

# Tools packaged by every supported Ubuntu release. Optional tools are checked
# with apt-cache below and installed by their upstream installer if missing.
# bsdextrautils provides col, which fish's MANPAGER pipeline uses to strip
# overstrike codes before bat renders a man page. openssh-server provides the
# WSL2 sshd (configured on port 2222 by run_onchange_after_45-wsl-ssh.sh.tmpl);
# it is Linux-only because macOS and Windows have their own SSH servers. wslu
# provides wslview so BROWSER opens URLs in the Windows browser; it only exists
# in the WSL2 distribution.
PACKAGES="
ca-certificates
curl
wget
git
git-lfs
build-essential
unzip
zip
fish
ripgrep
fd-find
bat
fzf
zoxide
eza
jq
tree
htop
btop
tmux
bsdextrautils
mosh
openssh-server
neovim
emacs
direnv
gh
awscli
starship
lazygit
zellij
git-delta
podman
uv
ruff
ollama
opencode
fnm
prettier
shfmt
shellcheck
{{ if .isWSL }}wslu{{ end }}
"

echo "==> apt-get update"
# A mirror hiccup should not abort the whole bootstrap while usable package
# indexes are still cached; the install step below will report real failures.
as_root env DEBIAN_FRONTEND=noninteractive apt-get update -y ||
    echo "warning: apt-get update failed; using cached package indexes" >&2

available=""
unavailable=""
for pkg in $PACKAGES; do
    if dpkg -s "$pkg" >/dev/null 2>&1; then
        continue
    fi
    # `apt-cache show` also succeeds for a name that is only referenced by
    # another package's dependencies (on Ubuntu 26.04, `ruff` is a dependency
    # of helix) even though there is nothing to install. Require a candidate.
    if apt-cache policy "$pkg" 2>/dev/null | grep -q 'Candidate: [^(]'; then
        available="$available $pkg"
    else
        unavailable="$unavailable $pkg"
    fi
done

if [ -n "$available" ]; then
    echo "==> apt-get install:$available"
    # shellcheck disable=SC2086  # word splitting of the package list is intended
    if ! as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $available; then
        # One unavailable or conflicted package must not block every other
        # package in the list, so retry the batch one package at a time.
        echo "warning: batch install failed; retrying each package separately" >&2
        for pkg in $available; do
            as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$pkg" ||
                echo "warning: $pkg installation failed" >&2
        done
    fi
fi

# Ubuntu renames the upstream fd and bat binaries to fdfind and batcat. Link
# them into ~/.local/bin (first in PATH) so scripts, fzf, Emacs, Zellij and
# non-fish shells get the usual names too; the fish wrappers remain as a
# fallback for machines installed before this link existed.
for pair in fd:fdfind bat:batcat; do
    link_name=${pair%%:*}
    link_target=${pair#*:}
    if [ ! -e "$HOME/.local/bin/$link_name" ] && native_cmd "$link_target"; then
        ln -sf "$(command -v "$link_target")" "$HOME/.local/bin/$link_name"
    fi
done

# Fall back to the upstream installer only for tools that this Ubuntu release
# does not package. Downloads are best-effort so a transient network error does
# not block the rest of the dotfiles from being applied. Required tools are
# verified afterwards, though: this is a hash-gated `run_onchange_` script, so a
# swallowed failure would be recorded as a successful run and never retried.
missing=""
for pkg in $unavailable; do
    case "$pkg" in
    starship)
        has starship && continue
        echo "==> installing starship (not packaged by this Ubuntu release)"
        install_from_url starship https://starship.rs/install.sh \
            sh -y -b "$HOME/.local/bin"
        ;;
    zellij)
        has zellij && continue
        case "$(uname -m)" in
        x86_64 | amd64) zellij_arch=x86_64 ;;
        aarch64 | arm64) zellij_arch=aarch64 ;;
        *)
            echo "warning: no zellij build for $(uname -m)" >&2
            continue
            ;;
        esac
        echo "==> installing zellij (not packaged by this Ubuntu release)"
        tmpdir=$(mktemp -d)
        if curl -fsSL "https://github.com/zellij-org/zellij/releases/latest/download/zellij-${zellij_arch}-unknown-linux-musl.tar.gz" -o "$tmpdir/zellij.tar.gz"; then
            tar -xzf "$tmpdir/zellij.tar.gz" -C "$tmpdir"
            mkdir -p "$HOME/.local/bin"
            install -m 755 "$tmpdir/zellij" "$HOME/.local/bin/zellij"
        else
            echo "warning: zellij download failed" >&2
        fi
        rm -rf "$tmpdir"
        ;;
    uv)
        has uv && continue
        echo "==> installing uv (not packaged by this Ubuntu release)"
        install_from_url uv https://astral.sh/uv/install.sh sh
        ;;
    ruff)
        has ruff && continue
        if has uv; then
            echo "==> installing ruff (not packaged by this Ubuntu release)"
            # The managed ~/.config/uv/uv.toml is only applied after this
            # before_ script, so point uv at the TUNA PyPI mirror here too.
            UV_DEFAULT_INDEX=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
            export UV_DEFAULT_INDEX
            uv tool install ruff ||
                echo "warning: ruff installation failed" >&2
        else
            echo "warning: ruff needs uv or a manual install" >&2
        fi
        ;;
    ollama)
        # Ubuntu ships only the python3-ollama client library, so use the
        # upstream installer. It needs root, installs the ollama binary and,
        # when systemd is available, enables the service; in WSL without
        # systemd the binary is still installed and `ollama serve` works.
        has ollama && continue
        echo "==> installing ollama (not packaged by apt)"
        install_from_url ollama https://ollama.com/install.sh as_root_sh
        ;;
    opencode)
        has opencode && continue
        echo "==> installing opencode (not packaged by apt)"
        # --no-modify-path: fish/PowerShell configs already add ~/.opencode/bin.
        install_from_url opencode https://opencode.ai/v2/install bash --no-modify-path
        ;;
    fnm)
        # Node.js is managed by fnm on every platform, never by apt or
        # Homebrew: distro packages lag behind, and `fnm install --lts` plus
        # `fnm use`/`.node-version` is how versions are switched per project.
        if ! has fnm; then
            echo "==> installing fnm (not packaged by this Ubuntu release)"
            # --skip-shell: fish and the Spacemacs config wire fnm up, and the
            # installer would otherwise edit the login shell's rc file.
            install_from_url fnm https://fnm.vercel.app/install bash \
                --skip-shell --install-dir "$HOME/.local/share/fnm"
            hash -r 2>/dev/null || true
        fi
        if has fnm; then
            echo "==> installing Node.js LTS with fnm (not with apt)"
            # fnm downloads from nodejs.org by default; use the TUNA mirror,
            # the same one the apt and ELPA setup targets. TUNA no longer
            # mirrors npm, so npm packages come from npmmirror.
            FNM_NODE_DIST_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/
            export FNM_NODE_DIST_MIRROR
            npm_config_registry=https://registry.npmmirror.com/
            export npm_config_registry
            fnm install --lts ||
                echo "warning: fnm install --lts failed" >&2
            fnm default lts-latest ||
                echo "warning: fnm default failed" >&2
            # Put the default Node.js (and its npm) on PATH for the prettier
            # step below and for anything else later in this script. fnm infers
            # the shell from the parent process, which is fish when chezmoi is
            # launched from it, so force POSIX sh syntax here.
            eval "$(fnm env --shell bash)"
            hash -r 2>/dev/null || true
            if ! has node; then
                echo "warning: Node.js is still missing after fnm install --lts" >&2
                missing="$missing node"
            fi
        else
            echo "warning: fnm is unavailable; Node.js was not installed" >&2
            missing="$missing fnm"
        fi
        ;;
    prettier)
        # A Windows prettier on the inherited PATH does not count (see has()).
        has prettier && continue
        if has npm; then
            echo "==> installing prettier (npm, user prefix)"
            if ! npm install -g --prefix "$HOME/.local" prettier; then
                echo "warning: prettier installation failed" >&2
                missing="$missing prettier"
            fi
        else
            echo "warning: prettier needs npm from fnm; skipping prettier" >&2
            missing="$missing prettier"
        fi
        ;;
    *)
        echo "warning: $pkg is not available from apt; install it manually" >&2
        ;;
    esac
done

# AWS CDK is distributed through npm, so it is installed after fnm has put the
# default Node.js on PATH. Use the same ~/.local prefix as prettier so `cdk`
# stays available across fnm version switches.
if has npm; then
    if ! has cdk; then
        echo "==> installing AWS CDK (npm, user prefix)"
        if ! npm install -g --prefix "$HOME/.local" aws-cdk; then
            echo "warning: AWS CDK installation failed" >&2
            missing="$missing aws-cdk"
        fi
    fi
elif ! has cdk; then
    echo "warning: AWS CDK needs npm from fnm; skipping AWS CDK" >&2
    missing="$missing aws-cdk"
fi

# git-lfs is mandatory (the managed .gitconfig defines its clean/smudge
# filters), so a failed apt install must fail this run instead of being
# recorded as a successful apply.
if ! has git-lfs; then
    echo "warning: git-lfs is missing; LFS repositories will fail to check out" >&2
    missing="$missing git-lfs"
fi

# Ubuntu 26.04 packages Starship 1.22.1, which predates jj_bookmark and prints
# an "Unknown key" warning on every prompt. Upgrade in place; ~/.local/bin is
# first in PATH, so the newer binary shadows /usr/bin/starship.
if has starship; then
    starship_version=$(starship --version 2>/dev/null | awk 'NR == 1 {print $2}')
    if [ "$(printf '%s\n%s\n' "$STARSHIP_MIN_VERSION" "${starship_version:-0}" |
        sort -V | head -n 1)" != "$STARSHIP_MIN_VERSION" ]; then
        echo "==> upgrading starship to >= $STARSHIP_MIN_VERSION (found ${starship_version:-unknown})"
        install_from_url "starship upgrade" https://starship.rs/install.sh \
            sh -y -b "$HOME/.local/bin"
        hash -r 2>/dev/null || true
    fi
fi

if [ -n "$missing" ]; then
    echo "error: still missing after this run:$missing" >&2
    echo "       fix the cause (network, proxy or mirror) and run chezmoi apply again;" >&2
    echo "       the failure keeps this script scheduled to re-run." >&2
    exit 1
fi

echo "==> Linux packages complete"
{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Install packages on macOS with Homebrew.
set -eu

{{ include "scripts/lib/brew.sh" }}
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Homebrew downloads formula metadata and bottles from GitHub by default. Use
# the TUNA mirror, the same one the apt and ELPA setup targets, so installs on
# a fresh Mac are not bounded by GitHub's throughput in China.
HOMEBREW_API_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api
HOMEBREW_BOTTLE_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles
export HOMEBREW_API_DOMAIN HOMEBREW_BOTTLE_DOMAIN

if ! command -v brew >/dev/null 2>&1; then
    echo "==> installing Homebrew"
    # Interactive on purpose: on a fresh Mac this lets the Homebrew installer
    # offer to install the Xcode Command Line Tools as well.
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x /usr/local/bin/brew ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "warning: Homebrew is unavailable; skipping package installation" >&2
    exit 0
fi

BREW_PACKAGES="
git
git-lfs
fish
starship
ripgrep
fd
bat
eza
fzf
zoxide
jq
tree
htop
btop
tmux
mosh
zellij
neovim
emacs
direnv
gh
awscli
lazygit
git-delta
podman
uv
ruff
ollama
fnm
shfmt
shellcheck
diffutils
gnu-tar
wget
"

# gnu-tar is macOS-only: quelpa/package-build prefer `gtar` over the system
# BSD tar, which adds AppleDouble `._*` members that break Emacs'
# `package-tar-file-info` when building the code-review package. Linux already
# ships GNU tar and Windows gets it from Git for Windows, so it stays out of
# those lists.

# shellcheck disable=SC2086  # word splitting of the package list is intended
brew_install_missing formula $BREW_PACKAGES

# OpenCode's Homebrew formula lives in the upstream tap instead of homebrew-core.
if ! command -v opencode >/dev/null 2>&1; then
    echo "==> brew install anomalyco/tap/opencode-v2"
    brew install anomalyco/tap/opencode-v2 ||
        echo "warning: OpenCode installation failed" >&2
fi

# The Starship prompt uses Nerd Font glyphs. The font must be installed on the
# machine that renders the terminal, so it is a macOS cask (Linux/WSL render in
# the client terminal instead).
BREW_CASKS="
font-jetbrains-mono-nerd-font
ghostty
postman
wechatwebdevtools
"

# shellcheck disable=SC2086  # word splitting of the cask list is intended
brew_install_missing cask $BREW_CASKS

# Node.js is managed by fnm on every platform, never by apt or Homebrew: the
# distro formulae lag behind, and `fnm install --lts` plus `fnm use` or a
# project `.node-version` is how versions are switched. The `node` and
# `prettier` formulae are deliberately absent from BREW_PACKAGES because the
# `prettier` formula would pull Node.js back in as a dependency.
# This script is hash-gated, so verify the required tools afterwards and fail
# the apply when they are missing; otherwise chezmoi records the failure as a
# successful run and never retries it.
missing=""
if command -v fnm >/dev/null 2>&1; then
    echo "==> installing Node.js LTS with fnm (not with Homebrew)"
    # fnm downloads from nodejs.org by default; use the TUNA mirror, the same
    # one the apt and ELPA setup targets. TUNA no longer mirrors npm, so npm
    # packages come from npmmirror.
    FNM_NODE_DIST_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/
    export FNM_NODE_DIST_MIRROR
    npm_config_registry=https://registry.npmmirror.com/
    export npm_config_registry
    fnm install --lts ||
        echo "warning: fnm install --lts failed" >&2
    fnm default lts-latest ||
        echo "warning: fnm default failed" >&2
    # fnm infers the shell from the parent process; force sh syntax so the
    # macOS branch also works when chezmoi is started from fish or zsh.
    eval "$(fnm env --shell bash)"
    hash -r 2>/dev/null || true

    if ! command -v node >/dev/null 2>&1; then
        echo "warning: Node.js is still missing after fnm install --lts" >&2
        missing="$missing node"
    fi

    if command -v npm >/dev/null 2>&1; then
        if ! command -v prettier >/dev/null 2>&1; then
            echo "==> installing prettier (npm, user prefix)"
            mkdir -p "$HOME/.local/bin"
            if ! npm install -g --prefix "$HOME/.local" prettier; then
                echo "warning: prettier installation failed" >&2
                missing="$missing prettier"
            fi
        fi
        if ! command -v cdk >/dev/null 2>&1; then
            echo "==> installing AWS CDK (npm, user prefix)"
            mkdir -p "$HOME/.local/bin"
            if ! npm install -g --prefix "$HOME/.local" aws-cdk; then
                echo "warning: AWS CDK installation failed" >&2
                missing="$missing aws-cdk"
            fi
        fi
    else
        echo "warning: npm was not found; prettier and aws-cdk were not installed" >&2
        missing="$missing prettier aws-cdk"
    fi
else
    echo "warning: fnm is unavailable; Node.js, prettier and aws-cdk were not installed" >&2
    missing="$missing fnm"
fi

# git-lfs is mandatory: the managed .gitconfig defines its clean/smudge
# filters, so a failed Homebrew install must fail this run.
if ! command -v git-lfs >/dev/null 2>&1; then
    echo "warning: git-lfs is missing; LFS repositories will fail to check out" >&2
    missing="$missing git-lfs"
fi

if [ -n "$missing" ]; then
    echo "error: still missing after this run:$missing" >&2
    echo "       fix the cause (network, proxy or mirror) and run chezmoi apply again;" >&2
    echo "       the failure keeps this script scheduled to re-run." >&2
    exit 1
fi

echo "==> macOS packages complete"
{{ end -}}
