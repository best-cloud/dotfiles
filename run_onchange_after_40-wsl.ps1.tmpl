{{ if eq .chezmoi.os "windows" -}}
# Ensure the latest WSL2 and the Ubuntu distribution are installed.
# Rendered empty on other operating systems, so chezmoi skips it there.
$ErrorActionPreference = 'Continue'

function Test-IsAdmin {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Get-WslDistros {
    $output = & wsl.exe --list --quiet 2>$null
    if ($LASTEXITCODE -ne 0) {
        return @()
    }
    # wsl.exe writes UTF-16LE when its output is redirected; strip the NULs
    # before splitting so the names compare cleanly.
    return @(($output -join "`n") -replace "`0", '' -split "`r?`n" |
        ForEach-Object { $_.Trim() } | Where-Object { $_ })
}

function Add-WslFirewallRules {
    # Mirrored networking (the managed .wslconfig) exposes WSL listeners on the
    # Windows interfaces. Both the host firewall and the Hyper-V firewall filter
    # that traffic, so each needs an inbound allowance.
    $rules = @(
        @{ DisplayName = 'WSL2 SSH (TCP 2222)'; Name = 'WSL2-SSH-2222'; Protocol = 'TCP'; Ports = '2222' }
        @{ DisplayName = 'WSL2 mosh (UDP 60000-61000)'; Name = 'WSL2-Mosh-UDP'; Protocol = 'UDP'; Ports = '60000-61000' }
    )

    foreach ($rule in $rules) {
        if (Get-NetFirewallRule -DisplayName $rule.DisplayName -ErrorAction SilentlyContinue) {
            Write-Host "already present: $($rule.DisplayName)"
        } else {
            New-NetFirewallRule -DisplayName $rule.DisplayName -Direction Inbound `
                -Action Allow -Profile Any -Protocol $rule.Protocol -LocalPort $rule.Ports | Out-Null
            Write-Host "created firewall rule: $($rule.DisplayName)"
        }
    }

    $vmCreatorId = '{40E0AC32-46A5-438A-A0B2-2B479E8F2E90}'
    foreach ($rule in $rules) {
        if (Get-NetFirewallHyperVRule -Name $rule.Name -ErrorAction SilentlyContinue) {
            Write-Host "already present: $($rule.DisplayName) (Hyper-V firewall)"
        } else {
            New-NetFirewallHyperVRule -Name $rule.Name -DisplayName $rule.DisplayName `
                -Direction Inbound -VMCreatorId $vmCreatorId -Protocol $rule.Protocol `
                -LocalPorts $rule.Ports -Action Allow | Out-Null
            Write-Host "created firewall rule: $($rule.DisplayName) (Hyper-V firewall)"
        }
    }
}

if (-not (Get-Command wsl.exe -ErrorAction SilentlyContinue)) {
    Write-Warning 'wsl.exe was not found. Run "wsl --install --no-distribution" from an elevated PowerShell, then re-run chezmoi apply.'
    exit 0
}

# Installing or enabling the optional features needs an elevated shell.
& wsl.exe --status *> $null
if ($LASTEXITCODE -ne 0) {
    if (-not (Test-IsAdmin)) {
        Write-Warning 'WSL is not enabled yet. Run an elevated PowerShell and execute:'
        Write-Warning '    wsl --install --no-distribution'
        Write-Warning 'Reboot if asked, then re-run chezmoi apply.'
        exit 0
    }

    Write-Host '==> enabling WSL2'
    & wsl.exe --install --no-distribution
    if ($LASTEXITCODE -ne 0) {
        Write-Warning 'wsl --install failed; a reboot may be required. Re-run chezmoi apply afterwards.'
        exit 0
    }

    # A reboot is normally required before WSL can be used.
    & wsl.exe --status *> $null
    if ($LASTEXITCODE -ne 0) {
        Write-Warning 'WSL was enabled but is not usable yet; reboot and re-run chezmoi apply.'
        exit 0
    }
}

Write-Host '==> setting WSL2 as the default version'
& wsl.exe --set-default-version 2
if ($LASTEXITCODE -ne 0) {
    Write-Warning 'could not set the default WSL version to 2.'
}

# Ubuntu is the distribution name used by WezTerm and Windows Terminal. The
# "Ubuntu" alias always installs the current LTS release.
$distros = Get-WslDistros
if ($distros -contains 'Ubuntu') {
    Write-Host 'already installed: Ubuntu'
} else {
    Write-Host '==> installing Ubuntu'
    & wsl.exe --install --distribution Ubuntu --no-launch
    if ($LASTEXITCODE -ne 0) {
        Write-Warning 'Ubuntu installation failed. From an elevated PowerShell, try:'
        Write-Warning '    wsl --install --distribution Ubuntu'
    } else {
        Write-Host 'Ubuntu installed. Launch it once to create your Linux user.'
    }
}

# Allow LAN clients to reach the WSL2 Ubuntu sshd (port 2222) and mosh-server
# (UDP 60000-61000). The rules need an elevated shell, so warn when chezmoi was
# started without one instead of failing the rest of the apply.
if (Test-IsAdmin) {
    try {
        Add-WslFirewallRules
    } catch {
        Write-Warning "Could not create the WSL firewall rules: $($_.Exception.Message)"
        Write-Warning 'Launch Ubuntu once, delete the 40-wsl.ps1 entryState key, and re-run chezmoi apply elevated.'
    }
} else {
    Write-Warning 'WSL firewall rules need an elevated PowerShell; re-run chezmoi apply from one.'
}
{{ end -}}
