# Managed by chezmoi: %USERPROFILE%\.wslconfig on Windows.
# Mirrored networking makes WSL2 share the Windows host's network interfaces,
# so LAN clients can reach the Ubuntu sshd and mosh-server directly. The
# inbound firewall rules are created by run_onchange_after_40-wsl.ps1.tmpl.
# Run `wsl --shutdown` from Windows after this file changes.
[wsl2]
networkingMode=mirrored
# Give unused guest memory back to Windows gradually instead of holding a fixed
# VM cap; the default WSL VM otherwise keeps several GB after a build.
autoMemoryReclaim=gradual
# Grow the virtual disk on demand and shrink it when files are deleted.
sparseVhd=true
firewall=true

[experimental]
# With mirrored mode the host can also reach WSL services through the Windows
# IP, not only through localhost; useful for containers and LAN testing.
hostAddressLoopback=true
