# Chezmoi configuration for this machine.
#
# This file is rendered once by `chezmoi init`. Edit the template in the
# dotfiles repo, not ~/.config/chezmoi/chezmoi.toml.

# Pin the source directory. Without this, a local-checkout bootstrap leaves
# chezmoi pointing at the default source (~/.local/share/chezmoi), so later
# `chezmoi apply`/`status` calls fail.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    # Prompted on first init only; defaults make a non-interactive init work.
    name = {{ promptStringOnce . "name" "Your full name" "Your Name" | quote }}
    email = {{ promptStringOnce . "email" "Email address for Git commits" "you@example.com" | quote }}
    editor = "nvim"

    # Optional applications on every platform: yt-dlp plus its ffmpeg/Deno
    # dependencies, and desktop extras on Windows/macOS (1Password, Chrome,
    # Notion, IINA/PotPlayer, WeChat, music clients, ...). Development tools are
    # always installed by the package scripts; this only adds personal extras.
    # Change it by editing [data] in ~/.config/chezmoi/chezmoi.toml (or delete
    # the key and re-run `chezmoi init`).
    installOptionalApps = {{ promptBoolOnce . "installOptionalApps" "Install optional apps (yt-dlp, 1Password, Chrome, Notion, ...) [y/N]" false }}

    # Detected once at init and available to templates as isWSL, isMacOS and
    # isWindows. .chezmoi.kernel is empty on Windows and macOS, so only read
    # osrelease on Linux.
    isWSL = {{ if eq .chezmoi.os "linux" }}{{ contains "microsoft" .chezmoi.kernel.osrelease }}{{ else }}false{{ end }}
    isMacOS = {{ eq .chezmoi.os "darwin" }}
    isWindows = {{ eq .chezmoi.os "windows" }}
