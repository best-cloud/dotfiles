# Managed by chezmoi: Documents/PowerShell/Microsoft.PowerShell_profile.ps1
# Windows PowerShell 5.1 loads this through the shim in Documents/WindowsPowerShell.

# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------
# The PATH helper is shared with bootstrap.ps1 via scripts/lib/path.ps1.
{{ include "scripts/lib/path.ps1" }}
Add-PathEntry (Join-Path $HOME '.local\bin')

# winget installs portable CLI shims here (for example OpenCode and fnm).
$wingetLinks = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links'
if (Test-Path $wingetLinks) {
    Add-PathEntry $wingetLinks
}

# npm global packages (prettier, aws-cdk) land here. The Node.js MSI used to
# add this directory to PATH; fnm does not, so add it explicitly.
$npmBin = Join-Path $env:APPDATA 'npm'
if (Test-Path $npmBin) {
    Add-PathEntry $npmBin
}

# Deno's official installer uses ~/.deno/bin (winget exposes deno through the
# WinGet links directory above instead).
$denoBin = Join-Path $HOME '.deno\bin'
if (Test-Path $denoBin) {
    Add-PathEntry $denoBin
}

# Git LFS installs here and updates the persisted PATH; add it explicitly so a
# shell opened before the next sign-in can still run `git lfs`.
$gitLfsBin = Join-Path $env:ProgramFiles 'Git LFS'
if (Test-Path $gitLfsBin) {
    Add-PathEntry $gitLfsBin
}

# Node.js is managed by fnm on every platform. `--use-on-cd` switches versions
# automatically in directories with a .node-version or .nvmrc file. fnm
# downloads from nodejs.org by default; use the TUNA mirror, the same one the
# apt and ELPA setup targets, for reliable downloads in China. TUNA no longer
# mirrors npm, so npm packages (prettier, aws-cdk) come from npmmirror.
$env:FNM_NODE_DIST_MIRROR = 'https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/'
$env:npm_config_registry = 'https://registry.npmmirror.com/'
if (Get-Command fnm -ErrorAction SilentlyContinue) {
    fnm env --use-on-cd --shell powershell | Out-String | Invoke-Expression
}

# GNU Emacs installs into a versioned directory (for example
# C:\Program Files\Emacs\emacs-31.1\bin) and its installer does not add that
# directory to PATH, so resolve the newest install for terminal sessions.
$emacsRoot = Join-Path $env:ProgramFiles 'Emacs'
if (Test-Path $emacsRoot) {
    $emacsBin = Get-ChildItem $emacsRoot -Directory -Filter 'emacs-*' -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -match '^emacs-\d+(\.\d+)*$' } |
        Sort-Object { [version]($_.Name -replace '^emacs-', '') } -Descending |
        Select-Object -First 1 |
        ForEach-Object { Join-Path $_.FullName 'bin' }
    if ($emacsBin -and (Test-Path (Join-Path $emacsBin 'emacs.exe'))) {
        Add-PathEntry $emacsBin
    }
}

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Use Unix-style locations on Windows too, so the same managed dotfiles
# (Neovim, Starship, …) are found without duplicating configs.
$env:XDG_CONFIG_HOME = Join-Path $HOME '.config'
$env:XDG_DATA_HOME = Join-Path $HOME '.local\share'
$env:XDG_STATE_HOME = Join-Path $HOME '.local\state'
$env:XDG_CACHE_HOME = Join-Path $HOME '.cache'

$env:EDITOR = 'nvim'
$env:VISUAL = 'nvim'

# Keep one managed config file per tool on all three operating systems. bat,
# gh, eza and lazygit otherwise read a platform-specific directory on Windows.
$env:BAT_CONFIG_PATH = Join-Path $HOME '.config\bat\config'
$env:EZA_CONFIG_DIR = Join-Path $HOME '.config\eza'
$env:RIPGREP_CONFIG_PATH = Join-Path $HOME '.config\ripgrep\config'
$env:GH_CONFIG_DIR = Join-Path $HOME '.config\gh'
$env:LG_CONFIG_FILE = Join-Path $HOME '.config\lazygit\config.yml'

# fzf, with the same Catppuccin Mocha colors as dot_config/fish/config.fish.tmpl
# and the catppuccin/fzf port.
$env:FZF_DEFAULT_OPTS = '--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8,selected-bg:#45475a,border:#6c7086,label:#cdd6f4'

# Cross-industry telemetry opt-out plus the PowerShell-specific switch.
$env:DO_NOT_TRACK = '1'
$env:POWERSHELL_TELEMETRY_OPTOUT = '1'

# Emacs on Windows uses HOME to locate ~/.emacs.d. Keep it aligned with the
# PowerShell home so terminal and GUI Emacs see the same Spacemacs checkout.
if (-not $env:HOME) {
    $env:HOME = $HOME
}

# Zellij ignores XDG_CONFIG_HOME on Windows, so point it at the shared
# ~/.config/zellij/config.kdl managed by chezmoi.
$env:ZELLIJ_CONFIG_DIR = Join-Path $HOME '.config\zellij'

# Zellij opens cmd.exe for new panes when SHELL is unset. Point it at the
# PowerShell that loaded this profile so panes start in PowerShell instead.
if ($PSVersionTable.PSVersion.Major -ge 6) {
    $env:SHELL = 'pwsh'
} else {
    $env:SHELL = 'powershell'
}

# PowerShell 5.1 defaults to UTF-16 for redirected output, and native-command
# pipelines use the console code page. Force UTF-8 so files and pipes are
# readable by every other tool in this repository.
$OutputEncoding = [System.Text.UTF8Encoding]::new($false)
$outputEncodingName = if ($PSVersionTable.PSVersion.Major -ge 6) { 'utf8NoBOM' } else { 'utf8' }
$PSDefaultParameterValues['Out-File:Encoding'] = $outputEncodingName
$PSDefaultParameterValues['Set-Content:Encoding'] = $outputEncodingName
$PSDefaultParameterValues['Add-Content:Encoding'] = $outputEncodingName

# ---------------------------------------------------------------------------
# Small helpers, kept in sync with dot_config/fish/config.fish.tmpl
# ---------------------------------------------------------------------------
function mkcd {
    param([Parameter(Mandatory)][string]$Path)
    New-Item -ItemType Directory -Path $Path -Force | Out-Null
    Set-Location -Path $Path
}

function reload {
    . $PROFILE
}

# ---------------------------------------------------------------------------
# ssh-copy-id: Windows OpenSSH ships ssh and ssh-keygen but not the
# ssh-copy-id contrib script from Linux, so install a public key here.
# ---------------------------------------------------------------------------
function ssh-copy-id {
    param(
        [Parameter(Position = 0)]
        [string] $Target,

        # Linux: -i [identity_file]; defaults to the newest ~/.ssh/id*.pub.
        [Alias('i')]
        [string] $IdentityFile,

        [Alias('p')]
        [ValidateRange(1, 65535)]
        [int] $Port,

        # Linux: -o ssh_option. PowerShell cannot repeat a named parameter, so
        # pass several options as a comma-separated list.
        [Alias('o')]
        [string[]] $SshOption,

        # Linux: -F ssh_config. PowerShell parameter names are case-insensitive,
        # so -F would collide with the -f switch below and needs its own name.
        [string] $SshConfig,

        # Linux: -f, force mode (skip the "already installed" check).
        [switch] $f,

        # Linux: -n, dry run (print the key, install nothing).
        [switch] $n,

        [Alias('h')]
        [switch] $Help
    )

    if ($Help -or -not $Target) {
        Write-Host @'
Usage: ssh-copy-id [-h] [-f] [-n] [-i identity_file] [-p port] [-o ssh_option[,ssh_option]] [-SshConfig ssh_config] [user@]hostname

        -h                  print this help
        -f                  force mode: install the key even if the remote has it
        -n                  dry run: show the key without connecting
        -i identity_file    public key to install (default: newest ~/.ssh/id*.pub)
        -p port             port to connect to
        -o ssh_option       pass an option to ssh (comma-separate several)
        -SshConfig file     use an alternative ssh configuration (Linux: -F)

Example: ssh-copy-id -p 2222 user@example.com
'@
        return
    }

    $sshExe = Get-Command ssh -CommandType Application -ErrorAction SilentlyContinue |
        Select-Object -First 1 -ExpandProperty Source
    if (-not $sshExe) {
        $sshExe = Join-Path $env:SystemRoot 'System32\OpenSSH\ssh.exe'
    }
    if (-not (Test-Path -LiteralPath $sshExe)) {
        throw 'ssh was not found; install the OpenSSH Client capability first.'
    }

    if ($IdentityFile) {
        $keyPath = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($IdentityFile)
        if ($keyPath -notlike '*.pub') { $keyPath = "$keyPath.pub" }
        if (-not (Test-Path -LiteralPath $keyPath -PathType Leaf)) {
            throw "Identity file not found: $keyPath"
        }
    } else {
        # Same default as the Linux script: the newest id*.pub without -cert.
        $keyPath = Get-ChildItem -LiteralPath (Join-Path $HOME '.ssh') -Filter 'id*.pub' -File -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -notlike '*-cert.pub' } |
            Sort-Object LastWriteTime -Descending |
            Select-Object -First 1 -ExpandProperty FullName
        if (-not $keyPath) {
            throw 'No identities found in ~/.ssh; create one with: ssh-keygen -t ed25519'
        }
    }

    # Normalise CRLF so the remote authorized_keys gets a clean one-line key,
    # then trim: the newline is re-added when the key is piped to ssh.
    $key = ((Get-Content -LiteralPath $keyPath -Raw) -replace "`r", '').Trim()
    if (-not $key) {
        throw "Identity file is empty: $keyPath"
    }

    $sshArgs = @()
    if ($Port) { $sshArgs += @('-p', [string]$Port) }
    if ($SshConfig) {
        $sshArgs += @('-F', $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($SshConfig))
    }
    foreach ($option in $SshOption) {
        $sshArgs += @('-o', $option)
    }

    # One POSIX shell session installs the key: it appends the key from stdin,
    # creating ~/.ssh and authorized_keys with the usual permissions. Without
    # -f an existing key is skipped instead of duplicated. The sentinel keeps
    # login banners out of the result handling.
    $install = 'cd; umask 077; mkdir -p .ssh && chmod 700 .ssh && touch .ssh/authorized_keys && chmod 600 .ssh/authorized_keys || exit 1; key=$(cat); [ -n "$key" ] || exit 1; '
    if ($f) {
        $install += 'echo "$key" >> .ssh/authorized_keys || exit 1; echo __ssh_copy_id_added__'
    } else {
        $install += 'if grep -qxF -- "$key" .ssh/authorized_keys 2>/dev/null; then echo __ssh_copy_id_present__; else echo "$key" >> .ssh/authorized_keys || exit 1; echo __ssh_copy_id_added__; fi'
    }
    $remoteCommand = "exec sh -c '$install'"

    Write-Host "ssh-copy-id: INFO: Source of key(s) to be installed: $keyPath"
    if ($n) {
        Write-Host '=-=-=-=-=-=-=-='
        Write-Host 'Would have added the following key(s):'
        Write-Host ''
        Write-Host $key
        Write-Host '=-=-=-=-=-=-=-='
        return
    }

    $output = @($key | & $sshExe @sshArgs $Target $remoteCommand 2>&1)
    $status = $LASTEXITCODE
    $stdout = @($output | ForEach-Object { [string]$_ })

    if ($status -ne 0) {
        $text = ($stdout -join "`n").Trim()
        if ($text) { Write-Host $text }
        throw "ssh-copy-id: failed to copy the key to $Target (ssh exited with $status)."
    }

    # Match the sentinel as a whole line so banners cannot trigger it.
    $present = $false
    foreach ($line in $stdout) {
        if ($line.Trim() -eq '__ssh_copy_id_present__') { $present = $true; break }
    }
    if ($present) {
        Write-Warning 'ssh-copy-id: WARNING: All keys were skipped because they already exist on the remote system.'
        Write-Warning '        (if you think this is a mistake, you may want to use the -f option)'
        return
    }

    $sshPreview = (@('ssh') + $sshArgs + @($Target)) -join ' '
    Write-Host ''
    Write-Host 'Number of key(s) added: 1'
    Write-Host ''
    Write-Host "Now try logging into the machine, with: $sshPreview"
    Write-Host 'and check to make sure that only the key(s) you wanted were added.'
}

