# Managed by chezmoi: Documents/PowerShell/Microsoft.PowerShell_profile.ps1
# Windows PowerShell 5.1 loads this through the shim in Documents/WindowsPowerShell.

# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------
# The PATH helper is shared with bootstrap.ps1 via scripts/lib/path.ps1.
{{ include "scripts/lib/path.ps1" }}
Add-PathEntry (Join-Path $HOME '.local\bin')

# winget installs portable CLI shims here (for example OpenCode and fnm).
$wingetLinks = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links'
if (Test-Path $wingetLinks) {
    Add-PathEntry $wingetLinks
}

# npm global packages (prettier, aws-cdk) land here. The Node.js MSI used to
# add this directory to PATH; fnm does not, so add it explicitly.
$npmBin = Join-Path $env:APPDATA 'npm'
if (Test-Path $npmBin) {
    Add-PathEntry $npmBin
}

# Deno's official installer uses ~/.deno/bin (winget exposes deno through the
# WinGet links directory above instead).
$denoBin = Join-Path $HOME '.deno\bin'
if (Test-Path $denoBin) {
    Add-PathEntry $denoBin
}

# Git LFS installs here and updates the persisted PATH; add it explicitly so a
# shell opened before the next sign-in can still run `git lfs`.
$gitLfsBin = Join-Path $env:ProgramFiles 'Git LFS'
if (Test-Path $gitLfsBin) {
    Add-PathEntry $gitLfsBin
}

# Node.js is managed by fnm on every platform. `--use-on-cd` switches versions
# automatically in directories with a .node-version or .nvmrc file. fnm
# downloads from nodejs.org by default; use the TUNA mirror, the same one the
# apt and ELPA setup targets, for reliable downloads in China. TUNA no longer
# mirrors npm, so npm packages (prettier, aws-cdk) come from npmmirror.
$env:FNM_NODE_DIST_MIRROR = 'https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/'
$env:npm_config_registry = 'https://registry.npmmirror.com/'
if (Get-Command fnm -ErrorAction SilentlyContinue) {
    fnm env --use-on-cd --shell powershell | Out-String | Invoke-Expression
}

# GNU Emacs installs into a versioned directory (for example
# C:\Program Files\Emacs\emacs-31.1\bin) and its installer does not add that
# directory to PATH, so resolve the newest install for terminal sessions.
$emacsRoot = Join-Path $env:ProgramFiles 'Emacs'
if (Test-Path $emacsRoot) {
    $emacsBin = Get-ChildItem $emacsRoot -Directory -Filter 'emacs-*' -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -match '^emacs-\d+(\.\d+)*$' } |
        Sort-Object { [version]($_.Name -replace '^emacs-', '') } -Descending |
        Select-Object -First 1 |
        ForEach-Object { Join-Path $_.FullName 'bin' }
    if ($emacsBin -and (Test-Path (Join-Path $emacsBin 'emacs.exe'))) {
        Add-PathEntry $emacsBin
    }
}

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Use Unix-style locations on Windows too, so the same managed dotfiles
# (Neovim, Starship, …) are found without duplicating configs.
$env:XDG_CONFIG_HOME = Join-Path $HOME '.config'
$env:XDG_DATA_HOME = Join-Path $HOME '.local\share'
$env:XDG_STATE_HOME = Join-Path $HOME '.local\state'
$env:XDG_CACHE_HOME = Join-Path $HOME '.cache'

$env:EDITOR = 'nvim'
$env:VISUAL = 'nvim'

# Keep one managed config file per tool on all three operating systems. bat,
# gh and lazygit otherwise read a platform-specific directory on Windows.
$env:BAT_CONFIG_PATH = Join-Path $HOME '.config\bat\config'
$env:RIPGREP_CONFIG_PATH = Join-Path $HOME '.config\ripgrep\config'
$env:GH_CONFIG_DIR = Join-Path $HOME '.config\gh'
$env:LG_CONFIG_FILE = Join-Path $HOME '.config\lazygit\config.yml'

# Cross-industry telemetry opt-out plus the PowerShell-specific switch.
$env:DO_NOT_TRACK = '1'
$env:POWERSHELL_TELEMETRY_OPTOUT = '1'

# Emacs on Windows uses HOME to locate ~/.emacs.d. Keep it aligned with the
# PowerShell home so terminal and GUI Emacs see the same Spacemacs checkout.
if (-not $env:HOME) {
    $env:HOME = $HOME
}

# Zellij ignores XDG_CONFIG_HOME on Windows, so point it at the shared
# ~/.config/zellij/config.kdl managed by chezmoi.
$env:ZELLIJ_CONFIG_DIR = Join-Path $HOME '.config\zellij'

# Zellij opens cmd.exe for new panes when SHELL is unset. Point it at the
# PowerShell that loaded this profile so panes start in PowerShell instead.
if ($PSVersionTable.PSVersion.Major -ge 6) {
    $env:SHELL = 'pwsh'
} else {
    $env:SHELL = 'powershell'
}

# PowerShell 5.1 defaults to UTF-16 for redirected output, and native-command
# pipelines use the console code page. Force UTF-8 so files and pipes are
# readable by every other tool in this repository.
$OutputEncoding = [System.Text.UTF8Encoding]::new($false)
$outputEncodingName = if ($PSVersionTable.PSVersion.Major -ge 6) { 'utf8NoBOM' } else { 'utf8' }
$PSDefaultParameterValues['Out-File:Encoding'] = $outputEncodingName
$PSDefaultParameterValues['Set-Content:Encoding'] = $outputEncodingName
$PSDefaultParameterValues['Add-Content:Encoding'] = $outputEncodingName

# ---------------------------------------------------------------------------
# Small helpers, kept in sync with dot_config/fish/config.fish.tmpl
# ---------------------------------------------------------------------------
function mkcd {
    param([Parameter(Mandatory)][string]$Path)
    New-Item -ItemType Directory -Path $Path -Force | Out-Null
    Set-Location -Path $Path
}

function reload {
    . $PROFILE
}

# ---------------------------------------------------------------------------
# Prompt
# ---------------------------------------------------------------------------
if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (& starship init powershell)
}

# ---------------------------------------------------------------------------
# zoxide: `z <query>` and interactive `zi`
# ---------------------------------------------------------------------------
if (Get-Command zoxide -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (zoxide init powershell | Out-String) })
}

# ---------------------------------------------------------------------------
# direnv: load .envrc files automatically
# ---------------------------------------------------------------------------
if (Get-Command direnv -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (direnv hook pwsh | Out-String) })
}

# ---------------------------------------------------------------------------
# PSReadLine
# ---------------------------------------------------------------------------
if (Get-Module -ListAvailable PSReadLine) {
    Import-Module PSReadLine
    try {
        Set-PSReadLineOption -PredictionSource History
        Set-PSReadLineOption -PredictionViewStyle ListView
        Set-PSReadLineOption -EditMode Windows
        Set-PSReadLineOption -BellStyle None
        Set-PSReadLineOption -HistoryNoDuplicates
        Set-PSReadLineOption -MaximumHistoryCount 32767
        Set-PSReadLineOption -HistorySearchCursorMovesToEnd
        # Up/Down search history by the prefix already typed instead of
        # stepping through every entry.
        Set-PSReadLineKeyHandler -Key UpArrow -Function HistorySearchBackward
        Set-PSReadLineKeyHandler -Key DownArrow -Function HistorySearchForward
    } catch {
        # Older PSReadLine versions do not support every option above.
    }

    # Fuzzy history and file pickers. fzf is installed by the package scripts;
    # the built-in Ctrl+R is kept as the fallback when it is missing.
    if (Get-Command fzf -ErrorAction SilentlyContinue) {
        Set-PSReadLineKeyHandler -Chord 'Ctrl+r' -ScriptBlock {
            $historyPath = (Get-PSReadLineOption).HistorySavePath
            $lines = Get-Content -LiteralPath $historyPath -ErrorAction SilentlyContinue |
                Select-Object -Unique
            if (-not $lines) { return }
            $selection = $lines | fzf --height 40% --layout=reverse --border --tac
            if ($selection) {
                [Microsoft.PowerShell.PSConsoleReadLine]::RevertLine()
                [Microsoft.PowerShell.PSConsoleReadLine]::Insert($selection)
            }
        }
        Set-PSReadLineKeyHandler -Chord 'Ctrl+t' -ScriptBlock {
            if (Get-Command fd -ErrorAction SilentlyContinue) {
                $items = fd --type f --hidden --exclude .git
            } else {
                $items = Get-ChildItem -Recurse -File -ErrorAction SilentlyContinue |
                    ForEach-Object { $_.FullName }
            }
            $selection = $items | fzf --height 40% --layout=reverse --border
            if ($selection) {
                [Microsoft.PowerShell.PSConsoleReadLine]::Insert($selection)
            }
        }
    }
}

# ---------------------------------------------------------------------------
# Aliases and abbreviations, kept in sync with dot_config/fish/config.fish.tmpl.
# ---------------------------------------------------------------------------
if (Get-Command eza -ErrorAction SilentlyContinue) {
    # `ls` is an AllScope built-in alias; -Force would strip that option and
    # error, so keep it explicitly.
    Set-Alias -Name ls -Value eza -Option AllScope -Force
    function ll { eza -lah @args }
    function lt { eza --tree @args }
}
if (Get-Command bat -ErrorAction SilentlyContinue) {
    # `cat` is AllScope for the same reason as `ls` above.
    Set-Alias -Name cat -Value bat -Option AllScope -Force
}
if (Get-Command git -ErrorAction SilentlyContinue) {
    Set-Alias -Name g -Value git -Force
    # `gl` is a read-only built-in alias for Get-Location; it would shadow the
    # function, so force-remove it first.
    Remove-Item Alias:gl -Force -ErrorAction SilentlyContinue
    function gs { git status -sb @args }
    function gl { git log --oneline --graph --decorate --all @args }
    function gd { git diff @args }
    function gco { git checkout @args }
    function gsw { git switch @args }
    function grb { git rebase @args }
    function gaa { git add --all @args }
    function gpush { git push @args }
    function gpull { git pull @args }
}
if (Get-Command lazygit -ErrorAction SilentlyContinue) {
    Set-Alias -Name lg -Value lazygit -Force
}
if (Get-Command nvim -ErrorAction SilentlyContinue) {
    Set-Alias -Name vi -Value nvim -Force
}
if (Get-Command emacs -ErrorAction SilentlyContinue) {
    function e { emacs -nw @args }
}
if (Get-Command zellij -ErrorAction SilentlyContinue) {
    Set-Alias -Name zj -Value zellij -Force
    function za { zellij attach -c @args }
    function zls { zellij list-sessions @args }
}
if (Get-Command opencode -ErrorAction SilentlyContinue) {
    Set-Alias -Name o -Value opencode -Force
}
