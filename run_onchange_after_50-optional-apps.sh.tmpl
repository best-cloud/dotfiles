{{ if and (eq .chezmoi.os "darwin") (get . "installOptionalApps") -}}
#!/bin/sh
# Install optional applications on macOS with Homebrew.
# Opt in with `installOptionalApps = true` under [data] in
# ~/.config/chezmoi/chezmoi.toml, then run `chezmoi apply`.
# Keep these formulae and casks disjoint from BREW_PACKAGES/BREW_CASKS in
# run_onchange_before_10-install-packages.sh.tmpl; optional apps must not repeat
# the mandatory development tools.
set -eu

{{ include "scripts/lib/brew.sh" }}
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v brew >/dev/null 2>&1; then
    echo "warning: Homebrew is unavailable; skipping optional applications" >&2
    exit 0
fi

# yt-dlp's strongly recommended dependencies: ffmpeg/ffprobe, yt-dlp-ejs (the
# formula includes it) and Deno as the JavaScript runtime for yt-dlp-ejs.
BREW_TOOLS="
ffmpeg
deno
yt-dlp
"

# shellcheck disable=SC2086  # word splitting of the package list is intended
brew_install_missing formula $BREW_TOOLS

BREW_CASKS="
1password
google-chrome
notion
onlyoffice
iina
wechat
neteasemusic
openvpn-connect
windows-app
"

# shellcheck disable=SC2086  # word splitting of the cask list is intended
brew_install_missing cask $BREW_CASKS

# FlClash is published in the chen08209/tap tap rather than homebrew-cask, so
# it is installed separately: a tap failure must not block the casks above.
# Homebrew 7 refuses to load casks from third-party taps until they are
# trusted, so trust this specific cask after tapping and before installing.
if ! brew list --cask flclash >/dev/null 2>&1; then
    echo "==> brew tap chen08209/tap && brew trust --cask chen08209/tap/flclash"
    if ! brew tap chen08209/tap ||
        ! brew trust --cask chen08209/tap/flclash ||
        ! brew install --cask flclash; then
        echo "warning: FlClash installation failed" >&2
    fi
fi

echo "==> macOS optional applications complete"
{{ end -}}
