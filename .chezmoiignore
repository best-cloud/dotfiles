.github/**
scripts/**

# Windows-only targets. Windows Terminal and WezTerm are the Windows clients;
# Windows Terminal settings live under %LOCALAPPDATA%.
{{ if ne .chezmoi.os "windows" -}}
AppData/**
Documents/**
.wslconfig
.config/wezterm/**
{{ end -}}

# macOS-only targets. Ghostty is the macOS terminal.
{{ if ne .chezmoi.os "darwin" -}}
.config/ghostty/**
{{ end -}}

# Unix-only targets. Neovim and Zellij are kept because the Windows profile
# sets XDG_CONFIG_HOME (and ZELLIJ_CONFIG_DIR), so they read ~/.config on
# Windows as well.
{{ if eq .chezmoi.os "windows" -}}
.config/fish/**
{{ end -}}
