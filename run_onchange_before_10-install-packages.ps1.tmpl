{{ if eq .chezmoi.os "windows" -}}
# Install applications on Windows 11 with winget.
# Rendered empty on other operating systems, so chezmoi skips it there.
$ErrorActionPreference = 'Continue'

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning 'winget was not found; install App Installer from the Microsoft Store and re-run chezmoi apply.'
    exit 0
}

# Keep this list in sync with the apt/Homebrew lists in the .sh script.
$packages = @(
    'Microsoft.PowerShell'
    'Git.Git'
    'Microsoft.WindowsTerminal'
    'Microsoft.WSL'
    'wez.wezterm'
    'Starship.Starship'
    'BurntSushi.ripgrep.MSVC'
    'sharkdp.fd'
    'sharkdp.bat'
    'eza-community.eza'
    'junegunn.fzf'
    'ajeetdsouza.zoxide'
    'jqlang.jq'
    'Neovim.Neovim'
    'GNU.Emacs'
    'GitHub.cli'
    'Postman.Postman'
    'Tencent.WeixinDevTools'
    'astral-sh.uv'
    'astral-sh.ruff'
    'Zellij.Zellij'
    'JesseDuffield.lazygit'
    'Anomaly.OpenCode'
    'OpenJS.NodeJS.LTS'
    'mvdan.shfmt'
    'DEVCOM.JetBrainsMonoNerdFont'
)

# winget can intermittently fail with "Unrecognized command:
# '...\winget.exe'" when commands are called back-to-back on a fresh Windows
# install. The next attempt normally succeeds (winget-cli#5376). Exit code
# -1978335230 is winget's "invalid command line" result for that race.
function Test-WingetPackage {
    param([string]$Id)

    for ($attempt = 1; $attempt -le 3; $attempt++) {
        winget list --id $Id --exact --accept-source-agreements *> $null
        if ($LASTEXITCODE -eq 0) {
            return $true
        }
        if ($LASTEXITCODE -ne -1978335230) {
            return $false
        }
        if ($attempt -lt 3) {
            Start-Sleep -Seconds 3
        }
    }
    return $false
}

function Install-WingetPackage {
    param([string]$Id)

    for ($attempt = 1; $attempt -le 3; $attempt++) {
        winget install --id $Id --exact --source winget `
            --accept-package-agreements --accept-source-agreements `
            --silent --disable-interactivity
        if ($LASTEXITCODE -eq 0) {
            return $true
        }
        if ($attempt -lt 3) {
            Write-Warning "winget install $Id failed (exit $LASTEXITCODE); retrying in 3 seconds..."
            Start-Sleep -Seconds 3
        }
    }
    return $false
}

$failed = @()
foreach ($id in $packages) {
    if (Test-WingetPackage $id) {
        Write-Host "already installed: $id"
        continue
    }

    Write-Host "installing: $id"
    if (-not (Install-WingetPackage $id)) {
        $failed += $id
    }
}

if ($failed.Count -gt 0) {
    Write-Warning "Some winget packages failed: $($failed -join ', ')"
}

# Prettier (through npm) formats JS/TS/HTML/CSS/JSON/YAML/Markdown in Emacs.
# Node's MSI updates the persistent PATH, but this process may not see it yet,
# so prefer the known npm.cmd locations before falling back to Get-Command.
$prettierCmd = Join-Path $env:APPDATA 'npm\prettier.cmd'
if (-not (Test-Path $prettierCmd)) {
    $npmCmd = @(
        (Join-Path $env:ProgramFiles 'nodejs\npm.cmd')
        (Join-Path $env:LOCALAPPDATA 'Programs\nodejs\npm.cmd')
        (Get-Command npm.cmd -ErrorAction SilentlyContinue).Source
    ) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1

    if (-not $npmCmd) {
        $npm = Get-Command npm -ErrorAction SilentlyContinue
        if ($npm) { $npmCmd = $npm.Source }
    }

    if ($npmCmd) {
        Write-Host 'installing: prettier (npm)'
        & $npmCmd install -g prettier
        if ($LASTEXITCODE -ne 0) {
            Write-Warning 'prettier installation failed'
        }
    } else {
        Write-Warning 'npm was not found; prettier was not installed'
    }
}

Write-Host 'Windows packages complete. Open a new terminal to pick up PATH changes.'
{{ end -}}
