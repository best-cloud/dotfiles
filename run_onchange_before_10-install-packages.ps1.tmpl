{{ if eq .chezmoi.os "windows" -}}
# Install applications on Windows 11 with winget.
# Rendered empty on other operating systems, so chezmoi skips it there.
$ErrorActionPreference = 'Continue'

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning 'winget was not found; install App Installer from the Microsoft Store and re-run chezmoi apply.'
    exit 0
}

# Keep this list in sync with the apt/Homebrew lists in the .sh script.
# mosh and ollama are the deliberate Windows exceptions, both provided by the
# WSL2 Ubuntu distribution instead of a native install: mosh has no native
# Windows build or winget package, and Windows uses the WSL2 Ollama. From
# Windows, run them as `wsl mosh ...` and `wsl ollama ...`.
$packages = @(
    'Microsoft.PowerShell'
    'Git.Git'
    'Microsoft.WindowsTerminal'
    'Microsoft.WSL'
    'wez.wezterm'
    'Starship.Starship'
    'BurntSushi.ripgrep.MSVC'
    'sharkdp.fd'
    'sharkdp.bat'
    'eza-community.eza'
    'junegunn.fzf'
    'ajeetdsouza.zoxide'
    'jqlang.jq'
    'Neovim.Neovim'
    'GNU.Emacs'
    'GitHub.cli'
    'Amazon.AWSCLI'
    'Postman.Postman'
    'Tencent.WeixinDevTools'
    'astral-sh.uv'
    'astral-sh.ruff'
    'Zellij.Zellij'
    'JesseDuffield.lazygit'
    'Anomaly.OpenCode'
    'Schniz.fnm'
    'mvdan.shfmt'
    'koalaman.shellcheck'
    'DEVCOM.JetBrainsMonoNerdFont'
)

{{ include "scripts/lib/winget.ps1" }}
$failed = @()
foreach ($id in $packages) {
    if (Test-WingetPackage $id) {
        Write-Host "already installed: $id"
        continue
    }

    Write-Host "installing: $id"
    if (-not (Install-WingetPackage $id)) {
        $failed += $id
    }
}

if ($failed.Count -gt 0) {
    Write-Warning "Some winget packages failed: $($failed -join ', ')"
}

# Node.js is managed by fnm on every platform, never by the Node.js MSI. winget
# installs the portable fnm shim under WinGet\Links, which this process may not
# see on PATH yet, so probe the known location first.
$fnmCmd = @(
    (Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links\fnm.exe')
    (Get-Command fnm.exe -ErrorAction SilentlyContinue).Source
) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1

if ($fnmCmd) {
    Write-Host 'installing: Node.js LTS (fnm)'
    & $fnmCmd install --lts
    if ($LASTEXITCODE -ne 0) {
        Write-Warning 'fnm install --lts failed'
    }
    & $fnmCmd default lts-latest
    if ($LASTEXITCODE -ne 0) {
        Write-Warning 'fnm default lts-latest failed'
    }
    # Put the default Node.js and npm on PATH for the npm installs below.
    & $fnmCmd env --use-on-cd --shell powershell | Out-String | Invoke-Expression
} else {
    Write-Warning 'fnm was not found; Node.js, npm and aws-cdk were not installed'
}

# npm global packages go under %APPDATA%\npm (the conventional Windows prefix;
# the profile adds it to PATH). Prettier formats JS/TS/HTML/CSS/JSON/YAML/
# Markdown in Emacs, and AWS CDK is distributed through npm.
$npmBin = Join-Path $env:APPDATA 'npm'
$npmCmd = (Get-Command npm.cmd -ErrorAction SilentlyContinue).Source
if ($npmCmd) {
    if (-not (Test-Path (Join-Path $npmBin 'prettier.cmd'))) {
        Write-Host 'installing: prettier (npm)'
        & $npmCmd install -g --prefix $npmBin prettier
        if ($LASTEXITCODE -ne 0) {
            Write-Warning 'prettier installation failed'
        }
    }
    if (-not (Test-Path (Join-Path $npmBin 'cdk.cmd'))) {
        Write-Host 'installing: AWS CDK (npm)'
        & $npmCmd install -g --prefix $npmBin aws-cdk
        if ($LASTEXITCODE -ne 0) {
            Write-Warning 'AWS CDK installation failed'
        }
    }
} else {
    Write-Warning 'npm was not found; prettier and aws-cdk were not installed'
}

Write-Host 'Windows packages complete. Open a new terminal to pick up PATH changes.'
{{ end -}}
