# Managed by chezmoi: dot_config/ghostty/config.ghostty
#
# Primary terminal on macOS. Ghostty reads ~/.config/ghostty/config.ghostty
# there via the XDG search path; `config` is only the pre-1.2.3 fallback name.
# Run `ghostty +list-themes` and `ghostty +list-fonts` to see local names.
#
# The text area (font, palette, background and padding) is kept close to the
# managed WezTerm look, except the size: 14 pt suits the MacBook Air display
# where WezTerm's 12 pt is sized for the 2K Windows screen. Window chrome,
# sizing and macOS window behavior are Ghostty's own; this is not a WezTerm
# clone. Keep only the text-area settings in sync when changing fonts or colors.

font-family = "JetBrainsMono Nerd Font"
font-style = "Medium"
font-size = 14
# Slightly taller cells, close to WezTerm's 1.1 line height.
adjust-cell-height = 10%

# Built-in theme; Ghostty 1.2+ uses title case with spaces.
theme = Catppuccin Mocha
background-opacity = 0.92
background-blur = true

# Text-area padding; balance evens out the leftover pixels.
window-padding-x = 8
window-padding-y = 7
window-padding-balance = true
macos-titlebar-style = transparent
window-save-state = always

mouse-hide-while-typing = true
copy-on-select = clipboard
# Deep scrollback per terminal surface.
scrollback-limit = 100000000

# fish is the login shell managed by chezmoi.
shell-integration = fish
shell-integration-features = no-cursor

# macOS: only the left Option key acts as Alt, so the right one keeps typing
# symbols. Alt+Left/Right are unbound so the shell receives them for
# word-wise movement instead of Ghostty handling them.
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind

keybind = cmd+enter=toggle_fullscreen
