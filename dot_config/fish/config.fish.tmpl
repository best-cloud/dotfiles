# Managed by chezmoi. Edit dot_config/fish/config.fish.tmpl in the dotfiles
# repo instead of editing this file directly.

# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------
fish_add_path --global --move ~/.local/bin
fish_add_path --global --move ~/.cargo/bin
# opencode installs its launcher here.
fish_add_path --global ~/.opencode/bin

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew: /opt/homebrew on Apple Silicon, /usr/local on Intel.
if test -x /opt/homebrew/bin/brew
    eval (/opt/homebrew/bin/brew shellenv)
else if test -x /usr/local/bin/brew
    eval (/usr/local/bin/brew shellenv)
end
# Homebrew fetches formula metadata and bottles from GitHub by default. Use the
# TUNA mirror, the same one the apt and ELPA setup targets.
set -gx HOMEBREW_API_DOMAIN https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api
set -gx HOMEBREW_BOTTLE_DOMAIN https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles
# No analytics upload and no "next steps" hint after every install.
set -gx HOMEBREW_NO_ANALYTICS 1
set -gx HOMEBREW_NO_ENV_HINTS 1
{{ end -}}

# ---------------------------------------------------------------------------
# Node.js: managed by fnm, never by apt or Homebrew.
# ---------------------------------------------------------------------------
{{ if eq .chezmoi.os "linux" -}}
# The package script installs the fnm binary and the Node.js versions here.
fish_add_path --global ~/.local/share/fnm
{{ end -}}

# The official Deno installer places its binary here (the optional-apps scripts
# run it with --no-modify-path). Homebrew uses its own bin directory on macOS.
fish_add_path --global ~/.deno/bin

# fnm downloads Node.js from nodejs.org by default. Use the TUNA mirror, the
# same one the apt and ELPA setup targets, for reliable downloads in China.
set -gx FNM_NODE_DIST_MIRROR https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/
# TUNA no longer mirrors npm, so packages (prettier, aws-cdk) come from
# npmmirror through npm's npm_config_registry setting.
set -gx npm_config_registry https://registry.npmmirror.com/

# ---------------------------------------------------------------------------
# Shared configuration paths
# ---------------------------------------------------------------------------
# Keep one managed file per tool on all three operating systems. bat, gh and
# lazygit otherwise switch to a platform-specific directory on Windows/macOS.
set -gx BAT_CONFIG_PATH ~/.config/bat/config
set -gx RIPGREP_CONFIG_PATH ~/.config/ripgrep/config
set -gx GH_CONFIG_DIR ~/.config/gh
set -gx LG_CONFIG_FILE ~/.config/lazygit/config.yml

# Opt out of telemetry in tools that support the cross-industry convention.
set -gx DO_NOT_TRACK 1

# Put the default Node.js (and its npm) on PATH; --use-on-cd switches versions
# automatically when a directory has a .node-version or .nvmrc file.
if type -q fnm
    fnm env --use-on-cd --shell fish | source
end

# ---------------------------------------------------------------------------
# Debian/Ubuntu package names differ from the upstream binary names.
# Defining these wrappers here keeps a single config file for all systems.
# ---------------------------------------------------------------------------
if type -q fdfind; and not type -q fd
    function fd --description 'fd (Debian/Ubuntu package name)'
        fdfind $argv
    end
end

if type -q batcat; and not type -q bat
    function bat --description 'bat (Debian/Ubuntu package name)'
        batcat $argv
    end
end

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
set -gx EDITOR {{ .editor | quote }}
set -gx VISUAL {{ .editor | quote }}
set -gx PAGER less
set -gx LESS -R

# AWS CDK uses Podman on hosts without Docker. Podman is in the Linux and
# macOS package lists; Windows uses the WSL2 distribution instead.
if type -q podman
    set -gx CDK_DOCKER podman
end

# Use the real binary name here: MANPAGER runs under sh, where fish functions
# (such as the Debian `bat` wrapper above) are not available.
if type -q batcat
    set -gx MANPAGER "sh -c 'col -bx | batcat -l man -p'"
else if type -q bat
    set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"
end

{{ if .isWSL -}}
# wslu provides wslview; Ubuntu 26.04 does not package it, so install it
# manually if you want URLs to open in the Windows browser.
if type -q wslview
    set -gx BROWSER wslview
end
{{ end -}}

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------
# Both shells expose the same helpers; keep them in sync with the PowerShell
# profile (where `mkcd` and the git functions are defined too).
function mkcd --description 'Create a directory and enter it'
    if test (count $argv) -ne 1
        echo 'usage: mkcd <directory>' >&2
        return 1
    end
    mkdir -p -- $argv[1]; and cd -- $argv[1]
end

# ---------------------------------------------------------------------------
# Interactive shell
# ---------------------------------------------------------------------------
if status is-interactive
    set -g fish_greeting

    function reload --description 'Restart the interactive shell'
        exec fish
    end

    # Prompt
    if type -q starship
        starship init fish | source
    end

    # Smarter cd: `z <query>` and interactive `zi`.
    if type -q zoxide
        zoxide init fish | source
    end

    # Load .envrc files automatically.
    if type -q direnv
        direnv hook fish | source
    end

    # Fuzzy history and file search. fzf >= 0.48 can emit fish bindings
    # directly; Ubuntu 24.04 ships an older fzf with a bindings file instead.
    if type -q fzf
        if fzf --fish >/dev/null 2>&1
            fzf --fish | source
        else if test -f /usr/share/doc/fzf/examples/key-bindings.fish
            source /usr/share/doc/fzf/examples/key-bindings.fish
        end
        set -gx FZF_DEFAULT_OPTS '--height 40% --layout=reverse --border --info=inline'
        # FZF_DEFAULT_COMMAND runs under $SHELL, so use the actual binary name.
        if type -q fdfind
            set -gx FZF_DEFAULT_COMMAND 'fdfind --type f --hidden --exclude .git'
        else if type -q fd
            set -gx FZF_DEFAULT_COMMAND 'fd --type f --hidden --exclude .git'
        end
    end

    # Prefer the modern replacements when they are installed.
    if type -q eza
        abbr --add --global ls eza
        abbr --add --global ll 'eza -lah'
        abbr --add --global lt 'eza --tree'
    end
    if type -q bat
        abbr --add --global cat bat
    end

    if type -q git
        abbr --add --global g git
        abbr --add --global gs 'git status -sb'
        abbr --add --global gl 'git log --oneline --graph --decorate --all'
        abbr --add --global gd 'git diff'
        abbr --add --global gco 'git checkout'
        abbr --add --global gsw 'git switch'
        abbr --add --global grb 'git rebase'
        abbr --add --global gaa 'git add --all'
        abbr --add --global gpush 'git push'
        abbr --add --global gpull 'git pull'
    end
    if type -q lazygit
        abbr --add --global lg lazygit
    end
    if type -q nvim
        abbr --add --global vi nvim
    end
    if type -q emacs
        abbr --add --global e 'emacs -nw'
    end
    if type -q zellij
        abbr --add --global zj zellij
        abbr --add --global za 'zellij attach -c'
        abbr --add --global zls 'zellij list-sessions'
    end
    if type -q opencode
        abbr --add --global o opencode
    end
end

# Optional machine-specific settings that stay out of the repo.
if test -f ~/.config/fish/local.fish
    source ~/.config/fish/local.fish
end
